        <mxCell id="leitor" value="Nome: Leitor / Parser&#xa;Descrição: Analisa .class e decodifica estruturas para construir ClassFile em memória.&#xa;Implementado em: leitor.c, leitor.h, constantPoolDecoding.c, attributeDecoding.c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
