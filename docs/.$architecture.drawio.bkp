        <mxCell id="classfile" value="ClassFile :&#xa;Representa estrutura da classe carregada: constant pool, fields, methods e attributes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1eaff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="520" y="180" width="300" height="120" as="geometry" />
