        <mxCell id="cp" value="Constant Pool :&#xa;Tabela compartilhada de constantes usada para resolução de nomes, tipos e referências." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="890" y="350" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="attrs" value="Attributes &amp; Methods :&#xa;Contém métodos e atributos; code_attribute armazena bytecodes e metadados para execução." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ea7b0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="530" y="360" width="280" height="100" as="geometry" />
